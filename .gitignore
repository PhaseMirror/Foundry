# Build output.
/target/
**/target/
/.prism/

# The scaling harness writes its fits here; the committed artifact is the
# report in `oracles/`, not the raw run.
/reports/
criterion/

# cargo-fuzz working state. The corpus that matters is committed under
# `fuzz/corpus/`; the rest is machine-local.
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/target/

# Circom: the compiled `circom` binary and the nested upstream repos it is
# built from are machine-local tooling. `circuits/` sources are committed;
# `circom_src/` and `circomlib/` are fetched from pinned upstream commits.
/circom
/circom_src/
/circomlib/

# Circom circuit build intermediates.
*.r1cs
*.sym
*.zkey
*.ptau
*.wtns

# Lean build cache: the tracked sources are the `.lean` files.
.lake/
**/.lake/

# Research data: bulky, regenerable artifacts produced by the experiments.
# Prose, notebooks, and scripts that document a result stay tracked.
/research/

# Python tooling.
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node tooling.
node_modules/

# Editor and OS noise.
.DS_Store
*.swp
*~
.idea/
.vscode/

# `Cargo.lock` is NOT ignored: the resolved version of every oracle is part of
# the claim made against it (R11).
