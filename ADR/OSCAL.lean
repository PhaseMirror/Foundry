/-! ## 8. Consequence Entailment via the Embedded Logic (`PropTerm`/`Entails`)

The consequences of ADR-0068 are discharged as *logical consequences* of the
decision and context using the embedded propositional logic of `ADR.Core`
(`Entails`). Each consequence below is *derived*, never asserted.
-/

/-- The decision's contract, lifted to the embedded propositional logic:
adopt the Scopist as read-only, ingest the sealed receipt, and enforce
zero-drift. -/
def adr0068DecisionProp : PropTerm :=
  .and (.atom "adoptScopistAsReadOnly")
       (.and (.atom "ingestSealedReceipt") (.atom "zeroDriftEnforced"))

/-- Left-elimination for a single conjunctive premise. -/
theorem and_elim_left_oscal {p q : PropTerm} : Entails [.and p q] p := by
  intro env hprem
  rcases hprem (.and p q) (by simp) with ⟨hp, _⟩
  exact hp

/-- Right-elimination for a single conjunctive premise. -/
theorem and_elim_right_oscal {p q : PropTerm} : Entails [.and p q] q := by
  intro env hprem
  rcases hprem (.and p q) (by simp) with ⟨_, hq⟩
  exact hq

/-- **Consequence: Read-Only Scopist Commitment.** The decision commits to the
Legalese Scopist as the exclusive read-only translation layer. -/
@[proof]
theorem adr0068_scopist_commitment :
    Entails [adr0068DecisionProp] (.atom "adoptScopistAsReadOnly") := by
  simpa [adr0068DecisionProp]
    using (and_elim_left_oscal (p := .atom "adoptScopistAsReadOnly")
      (q := .and (.atom "ingestSealedReceipt") (.atom "zeroDriftEnforced")))

/-- **Consequence: Sealed-Receipt Ingestion.** The decision commits to ingesting
the cryptographically sealed ContractivityReceipt R. -/
@[proof]
theorem adr0068_receipt_commitment :
    Entails [adr0068DecisionProp] (.atom "ingestSealedReceipt") := by
  intro env hprem
  rcases hprem adr0068DecisionProp (by simp [adr0068DecisionProp]) with ⟨_, hbc⟩
  rcases hbc with ⟨hb, _⟩
  exact hb

/-- **Consequence: Zero-Drift Mandate.** The decision commits to zero-drift
enforcement. -/
@[proof]
theorem adr0068_zero_drift_mandate :
    Entails [adr0068DecisionProp] (.atom "zeroDriftEnforced") := by
  intro env hprem
  rcases hprem adr0068DecisionProp (by simp [adr0068DecisionProp]) with ⟨_, hbc⟩
  rcases hbc with ⟨_, hc⟩
  exact hc

/-- **Consequence: Kills Cannot Be Mitigated.** The zero-drift mandate entails
(by modus ponens, `ADR.Proofs.entailment_modus_ponens`) that a `SIG_GOV_KILL`
always yields an UNATTESTED narrative. -/
@[proof]
theorem adr0068_zero_drift_consequence_entailed :
    Entails [.atom "zeroDriftEnforced",
             .implies (.atom "zeroDriftEnforced") (.atom "killNarrativesUnattested")]
            (.atom "killNarrativesUnattested") :=
  entailment_modus_ponens _ _

/-- **Consequence: Packaging-Only OSCAL.** The read-only Scopist commitment
entails (modus ponens) that OSCAL is a packaging-only narrative envelope, never
a runtime attester. -/
@[proof]
theorem adr0068_packaging_only_entailed :
    Entails [.atom "adoptScopistAsReadOnly",
             .implies (.atom "adoptScopistAsReadOnly") (.atom "oscalPackagingOnly")]
            (.atom "oscalPackagingOnly") :=
  entailment_modus_ponens _ _

/-- **Consequence: Unattested Markings.** The zero-drift mandate entails (modus
ponens) that an SAR lacking a hashed R1CS / Lean proof manifest is UNATTESTED. -/
@[proof]
theorem adr0068_unattested_marking_entailed :
    Entails [.atom "zeroDriftEnforced",
             .implies (.atom "zeroDriftEnforced") (.atom "unattestedMarkings")]
            (.atom "unattestedMarkings") :=
  entailment_modus_ponens _ _

