[workspace]
members = [
    "compiler",
    "lexer",
    "parser",
    "mlir",
    "monitor",
    "benchmarks",
    "core",
    "telemetry-recorder",
]
resolver = "2"

[workspace.package]
version = "1.0.0-alpha"
edition = "2021"
rust-version = "1.81.0"
authors = ["Multiplicity Team"]
license = "MIT"
repository = "https://github.com/multiplicity-labs/multiplicity"
homepage = "https://multiplicity.ai"
description = "Multiplicity Global Workspace"

[workspace.dependencies]
tracing-subscriber = { version = "0.3", features = ["env-filter", "fmt", "json", "registry"] }
once_cell = "1.19"
tokio-stream = { version = "0.1", features = ["sync"] }
reqwest = { version = "0.12", features = ["json", "stream"] }
futures = "0.3"
axum = "0.7"
async-trait = "0.1"
env_logger = "0.10"
clap = { version = "4.5", features = ["derive"] }
uuid = { version = "1.0", features = ["v4", "serde"] }
uint = "0.10"
num-traits = "0.2"
num-integer = "0.1"
num-bigint = "0.4"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
tokio = { version = "1.0", features = ["full"] }
anyhow = "1.0"
thiserror = "2.0"
tracing = "0.1"
log = "0.4"
ndarray = { version = "0.16", features = ["serde"] }
approx = "0.5"
num-rational = "0.4"
base64 = "0.22"
chrono = { version = "0.4", features = ["serde"] }
schemars = { version = "0.8", features = ["chrono"] }
futures-core = "0.3"
prost = "0.13"
prost-types = "0.13"
tonic = "0.12"
bytes = "1.10"
dirs = "6.0"
num_cpus = "1.17"
tower = { version = "0.5", features = ["full"] }
tower-http = { version = "0.6", features = ["full"] }
argon2 = "0.5"
chacha20poly1305 = "0.10"
colored = "2.1"
dialoguer = "0.11"
indicatif = "0.17"
num-complex = "0.4"
ed25519-dalek = { version = "2.2.0", features = ["rand_core"] }
hmac = "0.12.1"
rand = "0.8.6"
regex = "1.12.2"
serde_yaml = "0.9.34"
sha2 = "0.10.9"
tempfile = "3.27.0"
hex = "0.4"
risc0-zkvm = "1.0"
