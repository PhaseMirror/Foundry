WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

ident = @{ ("_" | ASCII_ALPHANUMERIC)+ }
integer = @{ ASCII_DIGIT+ }
float = @{ integer ~ "." ~ integer }
version = { integer ~ "." ~ integer ~ ("." ~ integer )? }
ensemble_path = { ident ~ ("-" ~ ident)* }
item_path = { ident ~ ("::" ~ ident)* }
program = { SOI ~ (ensemble_decl | import_stmt | statement)* ~ EOI }
ensemble_decl = { "ensemble" ~ WHITESPACE+ ~ ident ~ WHITESPACE* ~ version }
import_stmt = { "use" ~ WHITESPACE+ ~ ensemble_path ~ ("::" ~ item_path)? ~ (WHITESPACE+ "as" ~ WHITESPACE+ ident)? ~ (WHITESPACE+ "with" ~ WHITESPACE+ "spectral_budget" ~ WHITESPACE* "=" ~ WHITESPACE* float)? ~ ";" }
statement = { struct_stmt | enum_stmt | if_stmt | loop_stmt | fndef_stmt | expr_stmt }
struct_stmt = { "struct" ~ WHITESPACE+ ~ ident ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (ident ~ ":" ~ ident ~ ("," ~ WHITESPACE* ~ ident ~ ":" ~ ident)*)? ~ "}" }
enum_stmt = { "enum" ~ WHITESPACE+ ~ ident ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (ident ~ ("(" ~ ident ~ ")")? ~ ("," ~ WHITESPACE* ~ ident ~ ("(" ~ ident ~ ")")?)*)? ~ "}" }
if_stmt = { "if" ~ WHITESPACE+ ~ expr ~ WHITESPACE* ~ block ~ (WHITESPACE* ~ "else" ~ WHITESPACE* ~ block)? }
loop_stmt = { "loop" ~ WHITESPACE* ~ block | "while" ~ WHITESPACE+ ~ expr ~ WHITESPACE* ~ block }
fndef_stmt = { "fn" ~ WHITESPACE+ ~ ident ~ WHITESPACE* ~ "(" ~ (ident ~ ("," ~ WHITESPACE* ~ ident)*)? ~ ")" ~ WHITESPACE* ~ block }
expr = { ident } // Placeholder for expression parsing
block = { "{" ~ WHITESPACE* ~ (statement ~ WHITESPACE*)* ~ "}" }
expr_stmt = { expr ~ ";" }
