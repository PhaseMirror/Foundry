[workspace]
members = [
    "z-mos-core",
    "pirtm",
]
resolver = "2"

[workspace.package]
version = "1.0.0-alpha"
edition = "2024"
authors = ["Multiplicity Foundation"]
license = "MIT"

[workspace.dependencies]
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
ndarray = { version = "0.17.2", features = ["serde"] }
thiserror = "2.0"
anyhow = "1.0"
pirtm-rs = { path = "pirtm" }
tracing = "0.1"
