{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://schemas.uor.foundation/prismpm/product-release/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "annotations": {
            "additionalProperties": {
              "maxLength": 4096,
              "type": "string"
            },
            "propertyNames": {
              "maxLength": 256,
              "minLength": 1
            },
            "type": "object"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "media_type": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "size": {
            "maximum": 10737418240,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "annotations",
          "digest",
          "media_type",
          "role",
          "size"
        ],
        "type": "object"
      },
      "maxItems": 65536,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "external_artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "license_expression": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[!-~]+(?: [!-~]+)*$",
            "type": "string"
          },
          "media_type": {
            "enum": [
              "application/vnd.oci.image.index.v1+json",
              "application/vnd.oci.image.manifest.v1+json",
              "application/vnd.docker.distribution.manifest.list.v2+json",
              "application/vnd.docker.distribution.manifest.v2+json"
            ]
          },
          "reference": {
            "maxLength": 512,
            "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "role": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "digest",
          "license_expression",
          "media_type",
          "reference",
          "role"
        ],
        "type": "object"
      },
      "maxItems": 4096,
      "type": "array",
      "uniqueItems": true
    },
    "model_digest": {
      "$ref": "#/$defs/digest"
    },
    "product": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "release": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "prismpm/product-release/1"
    },
    "sdk_digest": {
      "$ref": "#/$defs/digest"
    },
    "sdk_lock": {
      "$ref": "#/$defs/digest"
    },
    "standards_lock": {
      "$ref": "#/$defs/digest"
    },
    "status": {
      "enum": [
        "development",
        "candidate",
        "accepted",
        "retired"
      ]
    }
  },
  "required": [
    "artifacts",
    "external_artifacts",
    "model_digest",
    "product",
    "release",
    "schema",
    "sdk_digest",
    "sdk_lock",
    "standards_lock",
    "status"
  ],
  "type": "object"
}
