{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prismpm/project/1",
  "title": "ProjectConfig",
  "type": "object",
  "required": ["spec", "project", "lexlean_project", "build_root", "limits"],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "const": "prismpm/project/1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "lexlean_project": {
      "type": "string",
      "pattern": "^(?:\\.?[A-Za-z0-9_-][A-Za-z0-9_.-]*)(?:/(?:\\.?[A-Za-z0-9_-][A-Za-z0-9_.-]*))*$"
    },
    "build_root": {
      "type": "string",
      "pattern": "^(?:\\.[A-Za-z0-9_-]|[A-Za-z0-9_-])[A-Za-z0-9_.-]*$"
    },
    "limits": {
      "type": "object",
      "required": ["max_holo_bytes", "max_entities", "max_diagnostics"],
      "additionalProperties": false,
      "properties": {
        "max_holo_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "max_entities": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "max_diagnostics": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    }
  }
}
