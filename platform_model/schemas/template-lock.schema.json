{
  "$id": "https://schemas.uor.foundation/uor/template-lock/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 4096,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "policy_tree_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "uor/template-lock/1"
    },
    "sdk_image": {
      "pattern": "^[a-z0-9.-]+(?::[0-9]{1,5})?/[a-z0-9./_-]+@sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "template_repository": {
      "const": "https://github.com/UOR-Foundation/template"
    },
    "template_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "contract_digest",
    "policy_files",
    "policy_tree_sha256",
    "schema",
    "sdk_image",
    "template_repository",
    "template_revision"
  ],
  "type": "object"
}
