{
  "$id": "https://schemas.uor.foundation/prismpm/template-result/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changed": {
      "type": "boolean"
    },
    "contract_digest": {
      "$ref": "#/$defs/digest"
    },
    "patch": {
      "type": "string"
    },
    "policy_files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "policy_tree_sha256": {
      "$ref": "#/$defs/digest"
    },
    "proposed_lock": {
      "$ref": "#/$defs/templateLock"
    },
    "schema": {
      "enum": [
        "uor/template-check-result/1",
        "uor/template-update-result/1"
      ]
    },
    "sdk_image": {
      "pattern": "^[a-z0-9.-]+(?::[0-9]{1,5})?/[a-z0-9./_-]+@sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "status": {
      "const": "passed"
    },
    "template_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "schema"
  ],
  "title": "PrismPM template command result",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "schema": {
          "const": "uor/template-check-result/1"
        }
      },
      "required": [
        "contract_digest",
        "schema",
        "sdk_image",
        "status",
        "template_revision"
      ]
    },
    {
      "properties": {
        "schema": {
          "const": "uor/template-update-result/1"
        }
      },
      "required": [
        "changed",
        "patch",
        "proposed_lock",
        "schema"
      ]
    }
  ],
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "templateLock": {
      "additionalProperties": false,
      "properties": {
        "contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/digest"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "policy_tree_sha256": {
          "$ref": "#/$defs/digest"
        },
        "schema": {
          "const": "uor/template-lock/1"
        },
        "sdk_image": {
          "pattern": "^[a-z0-9.-]+(?::[0-9]{1,5})?/[a-z0-9./_-]+@sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "template_repository": {
          "const": "https://github.com/UOR-Foundation/template"
        },
        "template_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "contract_digest",
        "policy_files",
        "policy_tree_sha256",
        "schema",
        "sdk_image",
        "template_repository",
        "template_revision"
      ],
      "type": "object"
    }
  }
}
