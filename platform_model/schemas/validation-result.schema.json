{
  "$id": "https://schemas.uor.foundation/prismpm/validation-result/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attestation_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "covered": {"items": {"maxLength": 4096, "minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "evidence_path": {"oneOf": [{"pattern": "^\\.prism/evidence/oracle-[A-Za-z0-9._-]+-[0-9a-f]{64}-(valid|invalid)\\.intoto\\.json$", "type": "string"}, {"type": "null"}]},
    "oracle": {"maxLength": 128, "minLength": 1, "type": "string"},
    "oracle_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "schema": {"const": "prismpm/validation-result/1"},
    "subject": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "uncovered": {"items": {"maxLength": 4096, "minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "valid": {"const": true}
  },
  "required": ["attestation_digest", "covered", "evidence_path", "oracle", "oracle_digest", "schema", "subject", "uncovered", "valid"],
  "type": "object"
}
