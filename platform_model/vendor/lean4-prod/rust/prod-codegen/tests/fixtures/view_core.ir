(module FixtureViewCore
  (type "Operation"
    (ctor "Operation.Add") (ctor "Operation.Subtract")
    (ctor "Operation.Multiply") (ctor "Operation.Divide"))
  (type "CalculatorError"
    (ctor "CalculatorError.DivisionByZero") (ctor "CalculatorError.Overflow"))
  (def calculate ((operation (named "Operation")) (left Int64) (right Int64))
    (Result Int64 (named "CalculatorError"))
    (cases operation
      (alt "Operation.Add" () (ctor "Except.ok" left))
      (alt "Operation.Subtract" () (ctor "Except.ok" left))
      (alt "Operation.Multiply" () (ctor "Except.ok" left))
      (alt "Operation.Divide" () (ctor "Except.ok" left)))))
